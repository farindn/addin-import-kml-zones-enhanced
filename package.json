{
  "name": "addin-import-kml-zones-enhanced",
  "version": "3.5.2",
  "description": "MyGeotab add-in for importing Point, Polygon, and LineString KML zones.",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --config webpack.config.js --mode development",
    "test": "node --test test/*.test.js",
    "smoke": "node tools/smoke.js",
    "smoke:late": "node tools/smoke.js --late",
    "responsive": "node tools/responsive.js",
    "package:upload": "npm run build && python build_zip.py"
  },
  "dependencies": {
    "@geotab/zenith": "3.14.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.28.3",
    "@xmldom/xmldom": "^0.9.12",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
